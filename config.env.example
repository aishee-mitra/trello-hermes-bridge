# Trello -> Hermes bridge configuration
# Copy to config.env, replace every placeholder, and chmod 600 config.env.
# Never commit config.env.

# Trello API key and user token. Create these from the Trello account that owns
# the bridge integration. The token acts with that account's permissions.
TRELLO_API_KEY=REPLACE_WITH_TRELLO_API_KEY
TRELLO_TOKEN=REPLACE_WITH_TRELLO_USER_TOKEN

# Secret used by Trello to sign webhook deliveries. This is the application
# secret associated with the API key, not the user token.
TRELLO_WEBHOOK_SECRET=REPLACE_WITH_TRELLO_APPLICATION_SECRET

# Exact public callback URL registered with Trello, including /webhook.
TRELLO_CALLBACK_URL=https://REPLACE_WITH_PUBLIC_HOST/webhook

# Board watched by this bridge.
TRELLO_BOARD_ID=REPLACE_WITH_BOARD_ID

# Configurable identities: no usernames or IDs are hardcoded in the program.
# Both accounts must be members of the Trello board as appropriate.
AGENT_TRELLO_MEMBER_ID=REPLACE_WITH_AGENT_MEMBER_ID
AGENT_TRELLO_USERNAME=agent_username
MANAGER_TRELLO_MEMBER_ID=REPLACE_WITH_MANAGER_MEMBER_ID
MANAGER_TRELLO_USERNAME=manager_username

# Lifecycle lists on the board: Todo -> Doing -> Stuck -> Done -> Dropped.
LIST_ID_DOING=REPLACE_WITH_DOING_LIST_ID
LIST_ID_STUCK=REPLACE_WITH_STUCK_LIST_ID
LIST_ID_DONE=REPLACE_WITH_DONE_LIST_ID
LIST_ID_DROPPED=REPLACE_WITH_DROPPED_LIST_ID

# Runtime options.
BIND_HOST=0.0.0.0
BIND_PORT=8787
HERMES_BIN=/usr/local/bin/hermes  # or ~/.local/bin/hermes, or wherever your Hermes installation is
HERMES_MODEL=
PROJECT_DIR=/home/myuser/workspace/trello-hermes-bridge
DEDUP_WINDOW_SECONDS=300
MAX_CARD_COMMENTS=20
WORKER_LOG_RETENTION_DAYS=14
WORKER_LOG_MAX_FILES=50
WORKER_LOG_MAX_SIZE_BYTES=10485760

# Bridge state persistence (retry-state JSON)
BRIDGE_STATE_MAX_BYTES=65536
BRIDGE_STATE_TTL_SECONDS=604800
STALE_RUN_TIMEOUT_SECONDS=3600
